# EditorConfig — consistent formatting across editors
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C sources/headers and the linker script
[*.{c,h,ld}]
indent_style = space
indent_size = 4

# Makefiles conventionally use real tabs
[{Makefile,*.mk}]
indent_style = tab

# Config files read better at 2 spaces
[*.{json,yml,yaml}]
indent_size = 2

# Markdown uses trailing spaces for hard line breaks — don't strip them
[*.md]
trim_trailing_whitespace = false